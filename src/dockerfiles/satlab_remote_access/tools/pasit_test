# Run PASIT testbed suite on a Satlab host.
#
# This script can be used to run PASIT testbed suite on a Satlab host.
# It can be used to run the suite on a ChromeOS or Android device.
#
# To run the suite, run:
# ./pasit_test
# To run the suite in quick mode (bypassing re-running of the setup), run:
# ./pasit_test -q
# To pass additional arguments to the test suite, run:
# ./pasit_test [-q] -- <arg1> <arg2> <arg3>...
# To run passport client commands, run:
# ./pasit_test -p -- <command> <subcommand> <subcommand args>...


UNENROLLED=0
TOPOLOGY_FILE=""
DUT_IP_ARG=""
SERVO_SERIAL_ARG=""
SERVO_BOARD_ARG=""
SERVO_MODEL_ARG=""

SERVO_SERIAL=""
SERVO_BOARD=""
SERVO_MODEL=""

usage() {
  echo "Usage: $0 [-h|--help] [-q|--quick] [-p|--passport] [-u|--upload-logs] [--pause-on-fail <seconds>] [--] [args...]"
  echo
  echo "Run PASIT testbed suite on a Satlab host."
  echo
  echo "This script can be used to run the suite on a ChromeOS or Android device."
  echo
  echo "Options:"
  echo "  -h, --help          Show this help message and exit."
  echo "  --unenrolled        Enable unenrolled DUT mode."
  echo "  --topology-file <file> [Optional with --unenrolled] Path to local topology JSON file"
  echo "                      (if omitted, UFS topology is used. Download from go/pasit-drive and SCP)."
  echo "  --dut-ip <ip>       [Optional with --unenrolled] Explicit DUT IP address (bypasses discovery)."
  echo "  --servo-serial <serial> [Optional with --unenrolled] Override discovered servo serial."
  echo "  --servo-board <board>   [Required with --unenrolled] Servo board name (e.g. brya)."
  echo "  --servo-model <model>   [Optional with --unenrolled] Override discovered model name."
  echo "  -q, --quick         Quick mode. Bypasses re-running of the setup."
  echo "  -p, --passport      Run passport client commands."
  echo "  --pause-on-fail <seconds>  Pause for <seconds> on test failure."
  echo "  -- [args...]        All arguments after '--' are passed to the test suite or passport client."
  echo
  echo "Examples:"
  echo "  # Run the full test suite setup and execution"
  echo "  $0"
  echo
  echo "  # Run in quick mode (bypasses setup)"
  echo "  $0 -q"
  echo
  echo "  # Pass additional arguments to the test suite"
  echo "  $0 -q -- --tests=<Class Name>[.<Test Name>]"
  echo
  echo "  # Run a passport client command"
  echo "  $0 -p -- -h"
  echo
  echo "  # Upload all logs to the gcs bucket"
  echo "  $0 -u"
  exit 1
}


PASSPORT_DOCKER_REGISTRY="${PASSPORT_DOCKER_REGISTRY:-us-docker.pkg.dev/cros-passport}"
PASSPORT_INTERNAL_DOCKER_REGISTRY="${PASSPORT_INTERNAL_DOCKER_REGISTRY:-us-docker.pkg.dev/cros-passport-internal}"
PASIT_TAG="${PASIT_TAG:-latest}"
PASIT_ANDROID_IMAGE_PATH="${PASIT_ANDROID_IMAGE:-${PASSPORT_DOCKER_REGISTRY}/testbed/android}"
PASIT_CROS_IMAGE="${PASIT_CROS_IMAGE:-${PASSPORT_INTERNAL_DOCKER_REGISTRY}/testbed/cros:${PASIT_TAG}}"
PASIT_VOLUME_NAME="pasit_volume"
PASIT_PERSISTENT_CONTAINER_NAME="pasit_persistent_container"
PASIT_PERSISTENT_LOG_CONTAINER_NAME="pasit_persistent_log_upload_container"

# Define ANSI color codes
# Note: \e or \x1B both represent the ESC character
RED='\e[31m'    # Error
GREEN='\e[32m'  # Good
YELLOW='\e[33m' # Warn
NC='\e[0m'      # No Color / Reset

# Function to print colored log messages
log_color() {
    local level="$1"
    local message="$2"
    local color=""

    case "$level" in
        "ERROR")
            color="$RED"
            ;;
        "GOOD")
            color="$GREEN"
            ;;
        "WARN")
            color="$YELLOW"
            ;;
        *)
            # Default to no color if level is unknown
            color="$NC"
            ;;
    esac

    # Print the log message with the chosen color and reset afterward
    echo -e "${color}[$level]${NC} $message"
}

summarize_test_output() {
  local log_file="$1"
  local class_name=""
  local summary_header="
================================================================================
                                TEST SUMMARY
================================================================================
"
  local summary_content=""

  while IFS= read -r line; do
    if echo "$line" | grep -q "=> "; then
      class_name=$(echo "$line" | sed 's/.*> \([^ ]*\) <.*/\1/')
    elif [[ "$line" == *'[Test]'* ]]; then
      # Extract test name and status
      local test_info
      test_info=$(echo "$line" | awk -F' \\[Test\\] ' '{print $2}')
      local test_name
      test_name=$(echo "$test_info" | awk '{print $1}')
      local test_status
      test_status=$(echo "$test_info" | awk '{print $2}')

      if [[ -n "$test_status" ]]; then
        local full_test_name="${class_name}.${test_name}"
        local status_string
        if [[ "$test_status" == "PASS" ]]; then
          status_string="${test_status} ✅"
        else
          status_string="${test_status} ❌"
        fi
        summary_content+=$(printf "%-89.89s %10s\n" "${full_test_name}" "${status_string}\n")
      fi
    fi
  done < "${log_file}"

  if [[ -n "${summary_content}" ]]; then
    echo -e "${summary_header}" | tee -a "${log_file}"
    echo -e "${summary_content}" | tee -a "${log_file}"
  fi
}

discover_unenrolled_dut_ip() {
  log_color INFO "Discovering unenrolled DUT IP from DHCP leases..."
  local leases
  leases=$(docker exec dhcp cat /var/lib/misc/dnsmasq.leases 2>/dev/null)
  if [[ -z "${leases}" ]]; then
    log_color ERROR "Failed to read DHCP leases from dhcp container."
    return 1
  fi

  local candidates=()
  while read -r line; do
    [[ -z "${line}" ]] && continue
    local ip
    ip=$(echo "$line" | awk '{print $3}')
    local name
    name=$(echo "$line" | awk '{print $4}')
    if [[ "${name}" != "IP_POWER" && "${ip}" != "192.168.231.110" ]]; then
      candidates+=("${ip}")
    fi
  done <<< "${leases}"

  if [[ ${#candidates[@]} -eq 0 ]]; then
    log_color ERROR "No candidate IPs found in DHCP leases."
    return 1
  fi

  log_color INFO "Testing candidate IPs: ${candidates[*]}"
  for ip in "${candidates[@]}"; do
    # Try ADB
    if nc -z -w 1 "${ip}" 5555 &> /dev/null; then
      DUT_IP="${ip}"
      log_color GOOD "Discovered Android DUT IP: ${DUT_IP}"
      return 0
    fi
    # Try SSH
    if nc -z -w 1 "${ip}" 22 &> /dev/null; then
      DUT_IP="${ip}"
      log_color GOOD "Discovered ChromeOS DUT IP: ${DUT_IP}"
      return 0
    fi
  done

  log_color ERROR "None of the candidate IPs responded to ADB (5555) or SSH (22)."
  return 1
}

discover_servo_serial() {
  log_color INFO "Discovering Servo serial via lsusb..."
  local servo_lines
  servo_lines=$(lsusb | grep -i "Servo" || true)
  if [[ -z "${servo_lines}" ]]; then
    log_color ERROR "No Servo devices found in lsusb output."
    return 1
  fi

  local count
  count=$(echo "${servo_lines}" | wc -l)
  if [[ "${count}" -gt 1 ]]; then
    log_color WARN "Multiple Servo devices found:"
    echo "${servo_lines}"
    log_color ERROR "Please specify which one to use with --servo-serial."
    return 1
  fi

  SERVO_SERIAL=$(echo "${servo_lines}" | awk '{print $NF}' | tr -d ')')
  log_color GOOD "Discovered Servo Serial: ${SERVO_SERIAL}"
  return 0
}

discover_model() {
  log_color INFO "Discovering model from DUT via ADB..."

  # Ensure we are connected
  adb connect "${DUT_IP}:5555" > /dev/null 2>&1

  if [[ -z "${SERVO_MODEL}" ]]; then
    local dev_model
    dev_model=$(adb -s "${DUT_IP}:5555" shell getprop ro.product.device 2>/dev/null | tr -d '\r')

    if [[ -n "${dev_model}" ]]; then
      SERVO_MODEL=$(echo "${dev_model}" | tr '[:upper:]' '[:lower:]')
      log_color GOOD "Discovered Model: ${SERVO_MODEL}"
    else
      log_color WARN "Failed to discover model name via ADB."
    fi
  fi
}

confirm_unenrolled_params() {
  log_color WARN "Parameters for Unenrolled DUT:"
  log_color WARN "  DUT IP:       ${DUT_IP}"
  log_color WARN "  Servo Serial: ${SERVO_SERIAL}"
  log_color WARN "  Servo Board:  ${SERVO_BOARD}"
  log_color WARN "  Servo Model:  ${SERVO_MODEL}"

  if [[ -z "${SERVO_BOARD}" ]]; then
    log_color ERROR "Board name is missing. Please provide it via --servo-board."
    exit 1
  fi
  if [[ -z "${SERVO_MODEL}" ]]; then
    log_color ERROR "Model name is missing. Please provide it via --servo-model."
    exit 1
  fi
  if [[ -z "${SERVO_SERIAL}" ]]; then
    log_color ERROR "Servo serial is missing. Please provide it via --servo-serial."
    exit 1
  fi

  if [[ -t 0 ]]; then
    read -p "Proceed with these values? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      log_color ERROR "Aborted by user."
      exit 1
    fi
  else
    log_color INFO "Non-interactive shell, proceeding automatically in 3 seconds..."
    sleep 3
  fi
}

setup_unenrolled_dut() {
  log_color INFO "Setting up unenrolled/swapped DUT environment..."

  if [[ -n "${TOPOLOGY_FILE}" ]]; then
    if [[ ! -f "${TOPOLOGY_FILE}" ]]; then
      log_color ERROR "Topology file not found: ${TOPOLOGY_FILE}"
      exit 1
    fi
    cp "${TOPOLOGY_FILE}" "${PASIT_JSON_FILE}"
    DUT_ID=$(jq -r .hostname "${PASIT_JSON_FILE}" 2>/dev/null)
    if [[ -z "${DUT_ID}" || "${DUT_ID}" == "null" ]]; then
      DUT_ID=$(jq -r '.devices[] | select(.type == "DUT") | .id' "${PASIT_JSON_FILE}" 2>/dev/null)
    fi
    if [[ -z "${DUT_ID}" || "${DUT_ID}" == "null" ]]; then
      log_color ERROR "Could not determine DUT ID from topology file."
      exit 1
    fi
    log_color GOOD "DUT ID (from topology): ${DUT_ID}"
  else
    log_color INFO "No topology file provided, fetching from UFS..."
    get_dut_info
    log_color GOOD "DUT ID (from UFS): ${DUT_ID}"
  fi

  # IP Discovery
  if [[ -n "${DUT_IP_ARG}" ]]; then
    DUT_IP="${DUT_IP_ARG}"
  else
    if ! discover_unenrolled_dut_ip; then
      exit 1
    fi
  fi

  # Servo Serial Discovery
  if [[ -n "${SERVO_SERIAL_ARG}" ]]; then
    SERVO_SERIAL="${SERVO_SERIAL_ARG}"
  else
    if ! discover_servo_serial; then
      exit 1
    fi
  fi

  # Board/Model Handling
  SERVO_BOARD="${SERVO_BOARD_ARG}"
  if [[ -z "${SERVO_BOARD}" ]]; then
    log_color ERROR "Board name is missing. --servo-board is required in unenrolled/swapped mode."
    exit 1
  fi

  SERVO_MODEL="${SERVO_MODEL_ARG}"
  if [[ -z "${SERVO_MODEL}" ]]; then
    discover_model
  fi

  confirm_unenrolled_params

  # Write dummy DUT_INFO_FILE
  echo "{\"servoHostname\": \"${DUT_ID}-docker_servod\"}" > "${DUT_INFO_FILE}"

  # Ensure ADB is connected for downstream scripts
  adb connect "${DUT_IP}:5555" > /dev/null 2>&1
}

check_running_on_satlab() {
  if [[ ! -x /usr/local/bin/satlab ]]; then
    log_color ERROR "No satlab command found, this script must be run on a satlab host."
    exit 1
  fi
}

check_satlab_drone_running_tests() {
  if [[ "$(docker exec drone docker ps | wc -l)" -gt 1 ]]; then
    log_color ERROR "Tests may be running on the satlab host, please wait for them to finish before running this script."
    exit 1
  fi
}

get_dut_info() {
  local dns_info="$(satlab get dns)"
  local dut_line="$(echo "$dns_info" | grep "satlab-" | grep -v -i -E "ip.*power|192.168.231.110")"
  DUT_LINE_COUNT="$(echo "$dut_line" | wc -l)"
  if [[ "${DUT_LINE_COUNT}" -eq 0 ]]; then
    log_color ERROR "Could not find any DUT in satlab DNS config."
    exit 1
  elif [[ "${DUT_LINE_COUNT}" -gt 1 ]]; then
    if [[ "${DUT_IP_OVERRIDE}" == "" ]]; then
      log_color INFO "Found the following DUTs:"
      echo "$dut_line"
      log_color ERROR "Found multiple DUTs in satlab DNS config, please check"
      log_color ERROR "the satlab config and remove any extra DUTs or set"
      log_color ERROR "the DUT_IP_OVERRIDE environment variable to the IP"
      log_color ERROR "address of the DUT you want to use."
      log_color ERROR "For example: export DUT_IP_OVERRIDE=192.168.231.123"
      exit 1
    fi
    DUT_IP="${DUT_IP_OVERRIDE}"
  else
    DUT_IP="$(echo "$dut_line" | awk '{print $1}')"
  fi
  DUT_ID="$(echo "$dut_line" | awk -v ip="${DUT_IP}" '$1 == ip {print $2}')"
  if [[ -z "${DUT_ID}" ]]; then
    log_color ERROR "Could not find DUT ID for DUT IP ${DUT_IP} in satlab DNS config."
    exit 1
  fi

  if ! satlab get dut "${DUT_ID}" > "${DUT_INFO_FILE}"; then
    log_color ERROR"Failed to get DUT info from satlab for ${DUT_ID}"
    exit 1
  fi

  jq '.. | .pasit? | select(. != null)' "${DUT_INFO_FILE}" > "${PASIT_JSON_FILE}"
}

function start_servod() {
  local SERVO_CONTAINER_NAME
  log_color INFO "Setting up servod for ${DUT_ID}..."

  SERVO_CONTAINER_NAME=$(jq -r '.. | .servoHostname? | select(. != null)' "${DUT_INFO_FILE}")
  if [[ -z "${SERVO_CONTAINER_NAME}" ]]; then
    SERVO_CONTAINER_NAME="${DUT_ID}-docker_servod"
  fi

  if [[ "${UNENROLLED}" -eq 1 ]]; then
    # Stop existing container
    docker rm -f "${SERVO_CONTAINER_NAME}" > /dev/null 2>&1

    log_color INFO "Starting servod for unenrolled DUT with board: ${SERVO_BOARD}, model: ${SERVO_MODEL}, serial: ${SERVO_SERIAL}"
    local start_output
    start_output=$(satlab servod start \
      -service-account-json /home/satlab/keys/pubsub-key-do-not-delete.json \
      -board "${SERVO_BOARD}" \
      -model "${SERVO_MODEL}" \
      -servo-serial "${SERVO_SERIAL}" \
      -servod-container-name "${SERVO_CONTAINER_NAME}" 2>&1)
    if [[ $? -ne 0 ]]; then
      log_color ERROR "Failed to start servod container."
      log_color ERROR "Output: ${start_output}"
      exit 1
    fi

    # Verify container is running
    sleep 2
    if ! docker ps --format '{{.Names}}' | grep -q "^${SERVO_CONTAINER_NAME}$"; then
      log_color ERROR "Servod container ${SERVO_CONTAINER_NAME} is not running."
      log_color ERROR "Container logs:"
      docker logs "${SERVO_CONTAINER_NAME}" | tail -n 20
      exit 1
    fi
  else
    satlab servod stop -service-account-json /home/satlab/keys/pubsub-key-do-not-delete.json -host "${DUT_ID}" > /dev/null 2>&1
    if ! satlab servod start -service-account-json /home/satlab/keys/pubsub-key-do-not-delete.json -host "${DUT_ID}"; then
      log_color ERROR "Failed to start servod for ${DUT_ID}"
      exit 1
    fi
  fi

  SERVO_IP="$(docker inspect -f '{{range.NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "${SERVO_CONTAINER_NAME}")"
  if [[ $? -ne 0 || -z "${SERVO_IP}" ]]; then
    log_color ERROR -e "\n\nERROR: Failed to get Servod container IP."
    exit 1
  fi
  log_color GOOD "Servod started, SERVO_IP: ${SERVO_IP}"
}

start_passport() {
  local PASSPORT_CONTAINER="passport-dev"
  local PASSPORT_DOCKER_IMAGE="${PASSPORT_DOCKER_REGISTRY}/passport/passport:latest"
  # stop any existing passport container
  docker rm -f "${PASSPORT_CONTAINER}" > /dev/null 2>&1

  if ! docker exec -i compose sh -c \
    "/usr/local/bin/docker pull ${PASSPORT_DOCKER_IMAGE}"; then
    log_color ERROR "failed to pull latest passport docker image"
    exit 1
  fi
  # start container
  log_color INFO "Starting passport container..."
  if ! docker run \
    -d \
    --rm \
    --name ${PASSPORT_CONTAINER} \
    --privileged \
    -p 8300:8300 \
    "${PASSPORT_DOCKER_IMAGE}" ; then
    echo "ERROR: failed to start passport container"
    exit 1
  fi

  PASSPORT_IP="$(docker inspect -f \
    '{{range.NetworkSettings.Networks}}{{.IPAddress}}{{end}}' \
    "${PASSPORT_CONTAINER}")"
  if [[ $? -ne 0 || -z "${PASSPORT_IP}" ]]; then
    log_color ERROR "Failed to get Passport container IP."
    exit 1
  fi
  log_color GOOD "passport started,PASSPORT_IP: ${PASSPORT_IP}"
}

setup_docker_credentials() {
  if ! docker exec -i compose sh -c \
      "cat /home/satlab/keys/pubsub-key-do-not-delete.json \
      | /usr/local/bin/docker login -u _json_key --password-stdin \
      ${PASSPORT_DOCKER_REGISTRY}" > /dev/null 2>&1; then
    log_color ERROR "Failed to login to docker registry."
    exit 1
  fi
  if ! docker exec -i compose sh -c \
      "cat /home/satlab/keys/pubsub-key-do-not-delete.json \
      | /usr/local/bin/docker login -u _json_key --password-stdin \
      ${PASSPORT_INTERNAL_DOCKER_REGISTRY}" > /dev/null 2>&1; then
    log_color WARN "Failed to login to internal docker registry."
  fi
}

pull_pasit_testbed_containers() {
  if ! docker exec -i compose sh -c \
    "/usr/local/bin/docker pull ${PASIT_ANDROID_IMAGE}"; then
    log_color ERROR "failed to pull ${PASIT_ANDROID_IMAGE}"
    exit 1
  fi
  if ! docker exec -i compose sh -c \
    "/usr/local/bin/docker pull ${PASIT_CROS_IMAGE}"; then
    log_color WARN "failed to pull ${PASIT_CROS_IMAGE} proceeding without it..."
  fi
}

determine_cros_or_android() {
  local android_port=5555
  local cros_port=22
  if nc -z -w 1 "${DUT_IP}" "${android_port}" &> /dev/null; then
    if ! adb connect "${DUT_IP}:${android_port}"; then
      log_color ERROR "Failed to connect to ADB on ${DUT_IP}:${android_port}."
      exit 1
    fi
    DEVICE_TYPE="android"
    FINGERPRINT="$(adb shell getprop ro.build.fingerprint)"
    CODENAME="$(adb shell getprop ro.build.version.codename)"
    if [[ -z "${FINGERPRINT}" || -z "${CODENAME}" ]]; then
      log_color ERROR "Failed to get fingerprint or codename from ADB for ${DUT_IP}."
      exit 1
    fi
    PASIT_ANDROID_IMAGE="${PASIT_ANDROID_IMAGE_PATH}:${PASIT_TAG}-${CODENAME}"
    log_color GOOD "Found an Android device (ADB) listening on ${DUT_IP}:${android_port}, running ${CODENAME} with fingerprint ${FINGERPRINT}."
    return
  fi
  if nc -z -w 1 "${DUT_IP}" "${cros_port}" &> /dev/null; then
    log_color GOOD "Found a ChromeOS device (SSH) listening on ${DUT_IP}:${cros_port}."
    DEVICE_TYPE="cros"
    # Define a default since this is used for config generation even on CrOS
    # device tests.
    PASIT_ANDROID_IMAGE="${PASIT_ANDROID_IMAGE_PATH}:${PASIT_TAG}"
    return
  fi
  log_color ERROR "Failed to find a ChromeOS or Android device listening on ${DUT_IP}."
  exit 1
}

create_volume_and_start_persistent_container() {
  # clean up any existing containers and volumes
  docker rm -f ${PASIT_PERSISTENT_CONTAINER_NAME} > /dev/null 2>&1
  docker volume rm ${PASIT_VOLUME_NAME} > /dev/null 2>&1

  docker volume create ${PASIT_VOLUME_NAME}
  # start a container and keep the container running for 1 hour
  # this container is used to copy files to and from the satlab host and the
  # pasit shared volume
  if ! docker run \
    -d \
    --rm \
    --name ${PASIT_PERSISTENT_CONTAINER_NAME} \
    --volume ${PASIT_VOLUME_NAME}:/workdir \
    --network host \
    --entrypoint /usr/bin/sleep \
    ${PASIT_ANDROID_IMAGE} 1h; then
    log_color ERROR "Failed to start PASIT persistent container."
    exit 1
  fi
}

generate_pasit_config() {
  create_volume_and_start_persistent_container
  # all the differen tools seem to return data slightly different we have to
  # massage the data a bit to make it work with topology_converter as dut info
  # doesn't return json in same format is shiavs :-(
  log_color INFO "Constructing the PASIT config yaml file..."
  cp ${PASIT_JSON_FILE} ${TEMP_DIR}/pasit_config_original.json
  sed -i 's/_id/Id/g' "${PASIT_JSON_FILE}"
  sed -i 's/_port/Port/g' "${PASIT_JSON_FILE}"
  sed -i 's/_name/Name/g' "${PASIT_JSON_FILE}"
  sed -i 's/_outlet/Outlet/g' "${PASIT_JSON_FILE}"
  sed -i 's/_type.*2$/Type": "TYPE_IP9850"/g' "${PASIT_JSON_FILE}"
  if ! docker cp ${TEMP_DIR}/pasit_config.json ${PASIT_PERSISTENT_CONTAINER_NAME}:/workdir; then
    log_color ERROR "Failed to copy PASIT config JSON file to shared volume."
    exit 1
  fi
  # use topology_converter to generate the YAML config
  if ! docker run -it --rm\
    -v ${PASIT_VOLUME_NAME}:/workdir \
    --entrypoint /tools/pasit/topology_converter \
    ${PASIT_ANDROID_IMAGE}  \
    convert \
    -i /workdir/pasit_config.json \
    -o /workdir/pasit_config.yaml; then
    log_color ERROR "Failed to generate PASIT config YAML file."
    log_color ERROR "Please check the PASIT config JSON file: ${PASIT_JSON_FILE}"
    exit 1
  fi
  # wait for the file to be written to the shared volume timeout after 30 seconds
  count=0
  while ! docker exec -i ${PASIT_PERSISTENT_CONTAINER_NAME} ls /workdir/pasit_config.yaml > /dev/null 2>&1; do
    sleep 1
    count=$((count+1))
    if [[ $count -gt 30 ]]; then
      log_color ERROR "Not able to find PASIT config YAML file in shared volume."
      exit 1
    fi
  done
  set -e
  docker cp ${PASIT_PERSISTENT_CONTAINER_NAME}:/workdir/pasit_config.yaml ${TEMP_DIR}/pasit_config.yaml
  # now we need to change some IP addresses and ports
  log_color INFO "modifying pasit_config.yaml: ${TEMP_DIR}/pasit_config.yaml"
  # servo_host -> IP address of servod container
  sed -i "s/servo_host: .*/servo_host: ${SERVO_IP}/g" \
    ${TEMP_DIR}/pasit_config.yaml
  # dut_ip -> IP address of DUT
  if [[ "${DEVICE_TYPE}" == "cros" ]]; then
    sed -i "s/AndroidDevice:.*/CrosDevice:\n    - hostname: ${DUT_IP}/" \
      ${TEMP_DIR}/pasit_config.yaml
  fi
  # passport service_host -> IP address of passport container
  sed -i "s/service_host: .*/service_host: ${PASSPORT_IP}/g" \
    ${TEMP_DIR}/pasit_config.yaml
  if [[ -n "${PAUSE_ON_FAIL_SECONDS}" ]]; then
    sed -i "/TestParams:/a \    on_fail_pause_seconds: ${PAUSE_ON_FAIL_SECONDS}" \
      "${TEMP_DIR}/pasit_config.yaml"
  fi
  docker cp ${TEMP_DIR}/pasit_config.yaml ${PASIT_PERSISTENT_CONTAINER_NAME}:/workdir/pasit_config.yaml
  set +e
  # generate png with topology_converter
  if ! docker run -it --rm\
    -v ${PASIT_VOLUME_NAME}:/workdir \
    --entrypoint /tools/pasit/topology_converter \
    ${PASIT_ANDROID_IMAGE}  \
    graph \
    -i /workdir/pasit_config.yaml \
    -o /workdir/pasit_config.png; then
    log_color ERROR "Failed to generate PASIT config PNG file."
  fi
  docker cp ${PASIT_PERSISTENT_CONTAINER_NAME}:/workdir/pasit_config.png ${TEMP_DIR}/pasit_config.png
  log_color GOOD "PASIT config YAML file generated: ${TEMP_DIR}/pasit_config.yaml"
}

run_pasit_testbed_suite() {
  log_color GOOD "Starting PASIT testbed suite..."
  local RUN_CONTAINER_NAME
  if [[ "${DEVICE_TYPE}" == "cros" ]]; then
    RUN_CONTAINER_NAME="cros_pasit_run_container"
    docker rm -f ${RUN_CONTAINER_NAME} > /dev/null 2>&1
    docker run \
      -v ${PASIT_VOLUME_NAME}:/workdir \
      --network host \
      --name ${RUN_CONTAINER_NAME} \
      ${PASIT_CROS_IMAGE} -- -c /workdir/pasit_config.yaml ${forwarded_args} \
      | tee ${TEMP_DIR}/pasit_run_output.txt
  else
    RUN_CONTAINER_NAME="${PASIT_PERSISTENT_CONTAINER_NAME}"
    # connect to the DUT via ADB in the persistent container
    docker exec ${PASIT_PERSISTENT_CONTAINER_NAME} adb connect "${DUT_IP}:5555"
    # run the test suite in the persistent container
    docker exec ${PASIT_PERSISTENT_CONTAINER_NAME} \
      /tools/pasit/DesktopPASITTestbedTests \
      -c /workdir/pasit_config.yaml ${forwarded_args} | tee ${TEMP_DIR}/pasit_run_output.txt
  fi

  summarize_test_output "${TEMP_DIR}/pasit_run_output.txt"

  local log_dir="$(grep 'Artifacts are saved in'  ${TEMP_DIR}/pasit_run_output.txt | cut -d '"' -f2)"
  # copy the logs to the host for easier debugging
  if ! docker cp ${RUN_CONTAINER_NAME}:${log_dir} ${TEMP_DIR}; then
    log_color ERROR "Failed to copy logs out of the persistent container."
    exit 1
  fi
  log_color INFO "logs can be found in ${TEMP_DIR}/$(basename ${log_dir}) directory"
}

upload_logs() {
  local GCS_LOGS_URL="https://pantheon.corp.google.com/storage/browser"
  local PASIT_SUBDIR="pasit_logs"
  local temp_dir="$(cat /tmp/pasit_temp_dir.txt)"
  if [[ -z "${temp_dir}" ]]; then
    log_color ERROR "No temp directory found, run tests before uploading logs."
    exit 1
  fi
  local gcs_bucket="$(jq -r .GCS_IMAGE_BUCKET /home/satlab/keys/satlab-config.json 2>/dev/null)"
  if [[ -z "${gcs_bucket}" ]]; then
    local internal_satlab_config="$(grep -c "satlab-internal-users" /home/satlab/keys/pubsub-key-do-not-delete.json 2>/dev/null)"
    if [[ "${internal_satlab_config}" -eq 0 ]]; then
      log_color ERROR "Failed to find GCS bucket in satlab config."
      exit 1
    else
      # use the throw away bucket for internal satlabs
      gcs_bucket="chromeos-throw-away-bucket"
    fi
  fi
  echo "Uploading logs to: gs://${gcs_bucket}..."
  # stop the persistent container
  docker stop ${PASIT_PERSISTENT_LOG_CONTAINER_NAME} > /dev/null 2>&1
  # start background container to upload the logs
  if ! docker run \
    -d \
    --rm \
    --name ${PASIT_PERSISTENT_LOG_CONTAINER_NAME} \
    --volume ${PASIT_VOLUME_NAME}:/workdir \
    --volume satlab_keys:/home/satlab/keys \
    --network host \
    google/cloud-sdk:396.0.0-slim sleep 1h; then
    log_color ERROR "Failed to start PASIT persistent container."
    exit 1
  fi
  if ! docker exec ${PASIT_PERSISTENT_LOG_CONTAINER_NAME} \
    gcloud auth login \
    --cred-file /home/satlab/keys/pubsub-key-do-not-delete.json; then
    log_color ERROR "Failed to login to gcloud for uploading logs to GCS."
    exit 1
  fi
  # copy the entire temp directory to the shared volume and upload it to GCS
  local upload_dir="pasit_test_$(date +%Y%m%d_%H%M%S)"
  local gcs_logs_dir="gs://${gcs_bucket}/${PASIT_SUBDIR}/${upload_dir}"
  docker cp ${temp_dir} ${PASIT_PERSISTENT_LOG_CONTAINER_NAME}:/workdir/${upload_dir}
  # clean up the temp directory to remove test related logs so they don't get
  # uploaded again
  find ${temp_dir} -type d -maxdepth 1 -mindepth 1 -exec rm -rf {} +
  rm ${temp_dir}/pasit_run_output.txt
  # copy any images generated by passport the exported logs dir
  if [[ $(docker exec ${PASIT_PERSISTENT_LOG_CONTAINER_NAME} find /workdir/ -maxdepth 1 -name *.jpg | wc -l) -gt 0 ]]; then
    docker exec ${PASIT_PERSISTENT_LOG_CONTAINER_NAME} mkdir /workdir/${upload_dir}/passport_images
    docker exec ${PASIT_PERSISTENT_LOG_CONTAINER_NAME} bash -c "mv /workdir/*.jpg /workdir/${upload_dir}/passport_images/"
  fi
  # upload the logs to GCS
  docker exec ${PASIT_PERSISTENT_LOG_CONTAINER_NAME} gsutil cp -r /workdir/${upload_dir} ${gcs_logs_dir}
  docker exec ${PASIT_PERSISTENT_LOG_CONTAINER_NAME} rm -rf /workdir/${upload_dir}

  echo
  echo
  echo "Logs uploaded successfully to ${GCS_LOGS_URL}/${gcs_bucket}/${PASIT_SUBDIR}/${upload_dir}."
  echo "File a bug at go/file-pasit-bug and include: the gcs link, dut_id, and "
  echo "satlab IP address in the bug description."
}

# parse the arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      ;;
    --)
      shift;
      break
      ;;
    --unenrolled)
      UNENROLLED=1
      shift;
      ;;
    --topology-file)
      TOPOLOGY_FILE="$2"
      shift 2
      ;;
    --dut-ip)
      DUT_IP_ARG="$2"
      shift 2
      ;;
    --servo-serial)
      SERVO_SERIAL_ARG="$2"
      shift 2
      ;;
    --servo-board)
      SERVO_BOARD_ARG="$2"
      shift 2
      ;;
    --servo-model)
      SERVO_MODEL_ARG="$2"
      shift 2
      ;;
    --quick|-q)
      QUICK_MODE=1
      shift;
      ;;
    --passport|-p)
      PASSPORT_CLIENT=1
      shift;
      ;;
    --upload-logs|-u)
      UPLOAD_LOGS=1
      shift;
      ;;
    --pause-on-fail)
      if [[ -z "$2" || ! "$2" =~ ^[0-9]+$ ]]; then
        log_color ERROR "--pause-on-fail requires a numeric argument for seconds."
        exit 1
      fi
      PAUSE_ON_FAIL_SECONDS="$2"
      shift 2
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done

check_running_on_satlab

if [[ $# -gt 0 ]]; then
  forwarded_args="${@}"
fi

check_satlab_drone_running_tests
set -o pipefail

if [[ "${UPLOAD_LOGS}" -eq 1 ]]; then
  upload_logs
  exit 0
elif [[ "${PASSPORT_CLIENT}" -eq 1 ]]; then
  if ! docker ps | grep "passport-dev"; then
    start_passport
  fi
  docker run --rm -it --volume ${PASIT_VOLUME_NAME}:/workdir -w /workdir \
   --network=host us-docker.pkg.dev/cros-passport/passport/passport:latest \
   /usr/bin/cros-passport ${forwarded_args}
  exit 0
fi
if [[ "${QUICK_MODE}" -ne 1 ]]; then
  TEMP_DIR="$(mktemp -d)"
  echo -n "${TEMP_DIR}" > /tmp/pasit_temp_dir.txt
  DUT_INFO_FILE="${TEMP_DIR}/dut_info.json"
  PASIT_JSON_FILE="${TEMP_DIR}/pasit_config.json"
  if [[ "${UNENROLLED}" -eq 1 ]]; then
    setup_unenrolled_dut
  else
    get_dut_info
  fi
  if [[ -z "$DUT_IP" ]]; then
    echo "No DUT found, please check the satlab config."
    exit 1
  fi
  if [[ -z "$DUT_ID" ]]; then
    echo "No IP Power found, please check the satlab config."
    exit 1
  fi
  log_color GOOD "Setting up for DUT: ${DUT_ID}"
  setup_docker_credentials
  determine_cros_or_android
  pull_pasit_testbed_containers
  start_passport
  start_servod
  generate_pasit_config
  echo -e "${DUT_IP}" > /tmp/pasit_dut_ip.txt
else
  TEMP_DIR="$(cat /tmp/pasit_temp_dir.txt)"
  DUT_IP="$(cat /tmp/pasit_dut_ip.txt)"
  if [[ -z "${DUT_IP}" || -z "${TEMP_DIR}" ]]; then
    log_color ERROR "Please run this script without --quick|-q to setup the containers."
    exit 1
  fi
  # skip the setup and use the existing containers for faster re-runs
  determine_cros_or_android
  log_color GOOD "Skipping setup and running tests on ${DUT_IP}"
  if [[ ! -f "${TEMP_DIR}/pasit_config.yaml" ]]; then
    log_color ERROR "PASIT config YAML file not found, please run this script without --quick|-q."
    exit 1
  fi
  # check if the necessary containers are running
  if ! docker ps | grep ${PASIT_PERSISTENT_CONTAINER_NAME}; then
    log_color ERROR "Persistent container is not running, please run this script without --quick|-q to setup the container."
    exit 1
  fi
  if ! docker ps | grep "docker_servod"; then
    log_color ERROR "Servod container is not running, please run this script without --quick|-q to setup the container."
    exit 1
  fi
  if ! docker ps | grep "passport-dev"; then
    log_color ERROR "Passport container is not running, please run this script without --quick|-q to setup the container."
    exit 1
  fi
fi
run_pasit_testbed_suite
