[Unit]
Description=Apply Staged Satlab Host Scripts
DefaultDependencies=no
After=local-fs.target
Before=docker.service satlab-upstart.service satlab-host-server.service

[Service]
Type=oneshot
ExecStart=/etc/satlab/satlab-apply-staged-updates
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target