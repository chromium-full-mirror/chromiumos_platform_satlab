echo "Prepare Docker on the host."
# usermod -aG docker $USER
chmod 666 /var/run/docker.sock
systemctl start docker.service
systemctl enable docker.service

# Create required folder and file to run docker for all users.
mkdir -p /etc/systemd/system/docker.service.d
cat > /etc/systemd/system/docker.service.d/override.conf <<'EOT'
[Service]
ExecStart=
ExecStart=/usr/bin/dockerd -H fd:// -H unix:///var/run/docker.sock -H tcp://0.0.0.0:2375
EOT
systemctl daemon-reload
systemctl restart docker.service