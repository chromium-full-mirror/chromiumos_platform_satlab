#!/bin/bash
# Copyright 2025 The Chromium OS Authors. All rights reserved.
# Use of this source code is governed by a BSD-style license that can be
# found in the LICENSE file.

# configuration script to get and set the port values from a configuration file
CONFIG="/etc/satlab/satlab.conf"
source "$CONFIG"

# --- UI Colors ---
C_YELLOW='\033[1;33m'
C_GREEN='\033[1;32m'
C_RED='\033[0;31m'
C_NC='\033[0m' # No Color

# --- Main Script Logic ---

echo "Welcome to the Satlab network configuration utility."
echo "---------------------------------------------------"

# Gather Physical Ethernet interfaces (Excluding Virtual and Wireless)
mapfile -t network_interfaces < <(
    for iface_path in /sys/class/net/*; do
        iface=$(basename "$iface_path")
        # Skip loopback
        [ "$iface" = "lo" ] && continue
        # Skip Virtual: check if the symlink target contains 'virtual'
        if readlink "$iface_path/device" | grep -q "virtual"; then
            continue
        fi
        # Skip Wireless: check for wireless or phy80211 directories
        if [ -d "$iface_path/wireless" ] || [ -d "$iface_path/phy80211" ]; then
            continue
        fi
        # Double check it is actually a physical device link
        if [ -L "$iface_path/device" ]; then
            echo "$iface"
        fi
    done
)

if [[ ${#network_interfaces[@]} -eq 0 ]]; then
    echo -e "${C_RED}Error: No physical Ethernet interfaces found. Exiting.${C_NC}"
    exit 1
fi

# Configure EXTERNAL_PORT_TO_INTERNET
while true; do
    echo
    echo -e "${C_YELLOW}Please specify the port connected to the Internet (EXTERNAL_PORT_TO_INTERNET).${C_NC}"

    # Suggestion logic
    suggested_iface=$(ip route | grep default | awk '{print $5}' | head -n 1)
    options=("${network_interfaces[@]}")

    if [[ -n "$suggested_iface" && " ${network_interfaces[*]} " =~ " ${suggested_iface} " ]]; then
        echo "Suggested interface (based on the default route): $suggested_iface"
        options=("$suggested_iface")
        for iface in "${network_interfaces[@]}"; do
            [[ "$iface" != "$suggested_iface" ]] && options+=("$iface")
        done
    fi

    PS3="Please enter your choice (1-${#options[@]}): "
    select opt in "${options[@]}"; do
        if [[ -n "$opt" ]]; then
            echo -e "Testing connectivity on ${C_YELLOW}$opt${C_NC}..."
            if ping -I "$opt" -c 2 -W 2 8.8.8.8 > /dev/null 2>&1; then
                echo -e "${C_GREEN}Connectivity verified!${C_NC}"
                new_external_port=$opt
                break 2
            else
                echo -e "${C_RED}Assertion Failed: No Internet access detected on $opt.${C_NC}"
                echo "Please check the cable connection and try again."
                break # Exit 'select' to re-prompt the 'while' loop
            fi
        else
            echo "Invalid selection. Please try again."
        fi
    done
done

# Configure INTERNAL_PORT_TO_DUTS

echo -e "\n${C_YELLOW}Configuring the port connected to the DUTs (INTERNAL_PORT_TO_DUTS)...${C_NC}"
# Filter out the already-chosen external port
internal_options=()
for iface in "${network_interfaces[@]}"; do
    [[ "$iface" != "$new_external_port" ]] && internal_options+=("$iface")
done

if [[ ${#internal_options[@]} -eq 0 ]]; then
    echo -e "${C_RED}Warning: No other physical interfaces available for DUT connection.${C_NC}"
    new_internal_port="none"
elif [[ ${#internal_options[@]} -eq 1 ]]; then
    new_internal_port="${internal_options[0]}"
    echo -e "Only one interface remains. ${C_GREEN}Automatically selecting: $new_internal_port${C_NC}"
else
    echo -e "Please specify the port connected to the DUTs:"
    PS3="Please enter your choice (1-${#internal_options[@]}): "
    select opt in "${internal_options[@]}"; do
        if [[ -n "$opt" ]]; then
            new_internal_port=$opt
            break
        else
            echo -e "${C_RED}Invalid selection. Please try again.${C_NC}"
        fi
    done
fi

# Display a summary of all changes for confirmation
echo
echo "---------------------------------------------------"
echo -e "${C_YELLOW}Configuration Summary${C_NC}"
echo "---------------------------------------------------"
printf "${C_GREEN}%-30s${C_NC}\n" "External Port (to Internet)"
printf "  %-10s %s\n" "Current:" "'${EXTERNAL_PORT_TO_INTERNET:-not set}'"
printf "  %-10s %s\n" "New:" "'${new_external_port}'"
echo
printf "${C_GREEN}%-30s${C_NC}\n" "Internal Port (to DUTs)"
printf "  %-10s %s\n" "Current:" "'${INTERNAL_PORT_TO_DUTS:-not set}'"
printf "  %-10s %s\n" "New:" "'${new_internal_port}'"
echo

# Ask for confirmation, apply and verify
read -rp "Apply these changes? (y/N): " confirm
if [[ "${confirm,,}" == "y" || "${confirm,,}" == "yes" ]]; then
    echo "Applying configuration..."
    set_config "EXTERNAL_PORT_TO_INTERNET" "$new_external_port"
    set_config "INTERNAL_PORT_TO_DUTS" "$new_internal_port"

    # --- Verification Step ---
    # Read the newly saved values back from the config file
    saved_external_port=$(grep "^EXTERNAL_PORT_TO_INTERNET=" "$CONFIG" | cut -d'=' -f2)
    saved_internal_port=$(grep "^INTERNAL_PORT_TO_DUTS=" "$CONFIG" | cut -d'=' -f2)

    # Compare the saved values with what we intended to write
    if [[ "$saved_external_port" == "$new_external_port" && "$saved_internal_port" == "$new_internal_port" ]]; then
        echo -e "${C_GREEN}Configuration saved and verified successfully in $CONFIG!${C_NC}"
    else
        echo -e "${C_RED}Error: Failed to save changes to $CONFIG. Please check permissions and file contents.${C_NC}"
    fi
else
    echo "Configuration cancelled. No changes were made."
fi
