[Unit]
Description=Satlab GRPC service
After=network.target
StartLimitIntervalSec=0
[Service]
Type=simple
Restart=always
RestartSec=1
User=root
ExecStart=/bin/bash -c "source /etc/satlab/satlab.conf && export HOST_IDENTIFIER && exec /etc/satlab/host_server/host_server"

[Install]
WantedBy=multi-user.target